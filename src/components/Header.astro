---
import Nav from './Nav.astro';
import ThemeToggle from '@/features/theme/components/ThemeToggle.astro';

const isHome = Astro.url.pathname === '/';
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href="/" aria-current={isHome ? 'page' : undefined}>
      kent caparas<span class="dot">.</span>
    </a>
    <Nav />
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50; /* above landed and dragged notes */
    view-transition-name: site-header;
    background: color-mix(in oklab, var(--color-bg) 86%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-line);
  }

  /* glass and rule fade in over the first 64px of scroll */
  @supports (animation-timeline: scroll()) {
    .site-header {
      animation: header-settle linear both;
      animation-timeline: scroll();
      animation-range: 0 64px;
    }
  }

  @keyframes header-settle {
    from {
      background-color: transparent;
      border-bottom-color: transparent;
      backdrop-filter: blur(0);
    }
  }

  .bar {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .brand {
    margin-right: auto;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    text-decoration: none;
  }

  .dot {
    color: var(--color-accent);
  }

  /* phones: brand and toggle share a row, nav gets its own */
  @media (max-width: 520px) {
    .bar {
      flex-wrap: wrap;
      row-gap: 4px;
      padding: 12px 20px 10px;
    }
    .bar > :global(nav) {
      order: 3;
      width: 100%;
    }
  }
</style>
