---
interface Props {
  text: string;
  id?: string;
}

const { text, id } = Astro.props;
---

<h2 class="section-label" id={id} data-reveal>{text}</h2>

<style>
  .section-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    color: var(--color-ink-faint);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin: 0 0 20px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-line);
  }
</style>
