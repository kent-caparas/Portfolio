---
import '@/styles/fonts.css';
import '@/styles/global.css';
import '@/styles/motion.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'kent caparas',
  description = "i build things. use cases excite me. ai forward deployed developer at trelent, wiring private ai into the workflows quietly draining a team's hours.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />

    {/* resolve theme and prove JS before first paint */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.remove('no-js');
        try {
          if (localStorage.getItem('theme') === 'dusk') {
            root.setAttribute('data-theme', 'dusk');
          }
        } catch (_) {}
      })();
    </script>

    {/* prerender same-site pages on hover so view transitions feel instant */}
    <script type="speculationrules" is:inline>
      {
        "prerender": [
          {
            "where": {
              "and": [
                { "href_matches": "/*" },
                { "not": { "href_matches": "/admin/*" } },
                { "not": { "href_matches": "/api/*" } }
              ]
            },
            "eagerness": "moderate"
          }
        ]
      }
    </script>

    {/* the name and body text paint in their real faces, no swap flash */}
    <link rel="preload" href="/fonts/basteleur/Basteleur-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/karrik/Karrik-Regular.woff2" as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Kent Caparas, writing"
      href={new URL('rss.xml', Astro.site)}
    />
  </head>
  <body>
    <Header />
    <main class="wrap">
      <slot />
    </main>
    <Footer />
  </body>
</html>
