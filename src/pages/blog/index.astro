---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/PageIntro.astro';
import PostRow from '@/features/blog/components/PostRow.astro';
import { getPublishedPosts } from '@/features/blog/lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout
  title="Writing, Kent Caparas"
  description="Notes from deploying AI with real teams, the things I build, and whatever I learned this week."
>
  <PageIntro
    title="Writing"
    lede="Notes from deploying AI with real teams, the things I build, and whatever I learned this week."
  />
  {posts.map((post) => <PostRow post={post} />)}
</BaseLayout>
