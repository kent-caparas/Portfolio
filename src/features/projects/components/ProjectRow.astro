---
import { projectTransitionName, statusLabel, type Project } from '../lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { name, status, description, tags } = project.data;
const href = `/projects/${project.id}`;
---

<a href={href} class="row" data-reveal>
  <div class="head">
    <h3 class="name" style={`view-transition-name: ${projectTransitionName(project)}`}>
      {name}
    </h3>
    <span class={`status ${status}`}>{statusLabel(status)}</span>
  </div>
  <p class="desc">{description}</p>
  <div class="tags">
    {tags.map((tag) => <span>{tag}</span>)}
  </div>
</a>

<style>
  .row {
    display: block;
    padding: 22px 0;
    border-bottom: 1px solid var(--color-line);
    color: inherit;
    text-decoration: none;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 6px;
  }

  .name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 650;
    line-height: 1.25;
    letter-spacing: -0.01em;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .row:hover .name {
    color: var(--color-accent);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-ink-faint);
  }

  .status.live {
    color: var(--color-good);
  }

  .status.live::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .desc {
    margin: 0 0 10px;
    max-width: 600px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--color-ink-dim);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-faint);
  }
</style>
