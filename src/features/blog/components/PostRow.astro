---
import { formatStamp, formatTag, postTransitionName, type Post } from '../lib/posts';

interface Props {
  post: Post;
  /** title and meta only, for the home page */
  compact?: boolean;
}

const { post, compact = false } = Astro.props;
const { title, date, tag, readingTime, excerpt } = post.data;
const href = `/blog/${post.id}`;
---

<a href={href} class="row" data-reveal>
  <div class="meta">
    <time datetime={date.toISOString()}>{formatStamp(date)}</time>
    <span>{formatTag(tag)}</span>
    {readingTime && <span>{readingTime} min</span>}
  </div>
  <div class="title-line">
    <h3 class="title" style={`view-transition-name: ${postTransitionName(post)}`}>
      {title}
    </h3>
    <span class="arrow" aria-hidden="true">→</span>
  </div>
  {!compact && <p class="excerpt">{excerpt}</p>}
</a>

<style>
  .row {
    display: block;
    padding: 22px 0;
    border-bottom: 1px solid var(--color-line);
    color: inherit;
    text-decoration: none;
  }

  .meta {
    display: flex;
    gap: 16px;
    margin-bottom: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--color-ink-faint);
  }

  .title-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .title {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 650;
    line-height: 1.25;
    letter-spacing: -0.01em;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .arrow {
    font-family: var(--font-mono);
    color: var(--color-accent);
    opacity: 0;
    translate: -8px 0;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      translate var(--dur-mid) var(--ease-out);
  }

  .excerpt {
    margin: 0;
    max-width: 600px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--color-ink-dim);
  }

  .row:hover .title {
    color: var(--color-accent);
  }

  .row:hover .arrow {
    opacity: 1;
    translate: 0 0;
  }
</style>
